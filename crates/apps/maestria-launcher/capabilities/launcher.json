{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "Local launcher window only",
  "local": true,
  "windows": ["launcher"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-launcher-ready",
    "allow-search",
    "allow-execute-action",
    "allow-dismiss",
    "allow-get-preferences",
    "allow-save-preferences",
    "allow-configure-shortcut",
    "allow-frame-ready"
  ]
}
